{
  "name": "@distube/plugins",
  "private": true,
  "description": "Official extractor plugins for DisTube",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "format": "oxfmt",
    "check": "oxlint --deny-warnings && oxfmt --check",
    "check:write": "oxlint --fix && oxfmt",
    "type": "bun run --filter '*' type",
    "verify": "bun run check && bun run type && bun run build"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsup": "^8.3.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.4.3"
}
