{
  "name": "@distube/youtube",
  "version": "1.1.0",
  "description": "A DisTube extractor plugin for supporting YouTube.",
  "keywords": [
    "discord",
    "distube",
    "music",
    "plugin"
  ],
  "homepage": "https://github.com/distubejs/plugins/tree/main/packages/youtube#readme",
  "bugs": {
    "url": "https://github.com/distubejs/plugins/issues"
  },
  "license": "MIT",
  "author": "Skick (https://github.com/skick1234)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/distubejs/plugins.git"
  },
  "funding": "https://github.com/skick1234/DisTube?sponsor",
  "directories": {
    "lib": "src"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "type": "tsrs --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@distube/ytdl-core": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "discord.js": "^14.16.3",
    "distube": "^5.0.2",
    "tslib": "^2.8.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "distube": "5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
